    {
      "id": "adr_chunk_loading",
      "label": "ADR: Chunk Loading Strategy",
      "file_type": "document",
      "source_file": "knowledge/decisions/chunk-loading-strategy.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": "admin",
      "rationale": "Chunk generation is CPU-heavy and cannot block the game loop. GPU upload requires main thread (OpenGL is not thread-safe), so results flow as Ready records from background threads to Game on main thread."
    },
    {
      "id": "adr_rendering",
      "label": "ADR: Chunk Rendering Approach",
      "file_type": "document",
      "source_file": "knowledge/decisions/rendering-approach.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": "admin",
      "rationale": "GLSL inlined as Java strings avoids path issues at different CWDs and keeps diffs readable in git. centroid out vec2 vUv prevents MSAA UV extrapolation bleeding. Atlas uses GL_NEAREST without mipmaps because tiles are edge-to-edge."
    },
